!artifacts/tflite/model.tflite
!artifacts/tflite/label.txt
!artifacts/confusion_matrix.png
!artifacts/training_curves.png
!artifacts/classification_report.csv

# ---------- Dataset (Sangat besar ~1.5GB, dilarang masuk git) ----------
dataset/
dataset_temp/
tensorflow_datasets/

